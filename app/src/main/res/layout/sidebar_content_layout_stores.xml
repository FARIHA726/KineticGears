<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@android:drawable/ic_dialog_info"
            app:tint="@color/industrial_red" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Main Warehouse"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Operating"
            android:textColor="#4CAF50"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="INVENTORY"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nav_stock_levels"
                style="@style/SidebarItem"
                android:drawableStart="@android:drawable/ic_menu_sort_by_size"
                android:drawablePadding="16dp"
                android:text="Stock Levels" />

            <TextView
                android:id="@+id/nav_locations"
                style="@style/SidebarItem"
                android:drawableStart="@android:drawable/ic_dialog_map"
                android:drawablePadding="16dp"
                android:text="Bin Locations" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#EEEEEE" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="OPERATIONS"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nav_pending_requests"
                style="@style/SidebarItem"
                android:drawableStart="@android:drawable/ic_menu_recent_history"
                android:drawablePadding="16dp"
                android:text="Pending Requests" />

            <TextView
                android:id="@+id/nav_reorder_list"
                style="@style/SidebarItem"
                android:drawableStart="@android:drawable/stat_sys_warning"
                android:drawablePadding="16dp"
                android:text="Reorder Alerts" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="#EEEEEE" />

            <TextView
                android:id="@+id/btnToggleTheme"
                style="@style/SidebarItem"
                android:drawableStart="@android:drawable/ic_menu_day"
                android:drawablePadding="16dp"
                android:text="Switch to Dark Mode" />

        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE" />

    <TextView
        android:id="@+id/tvLogout"
        style="@style/SidebarItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:drawableStart="@android:drawable/ic_menu_revert"
        android:drawablePadding="16dp"
        android:text="Logout"
        android:textColor="@color/industrial_red"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="16dp"
        android:text="KineticGear v1.0.4 - Stores"
        android:textColor="@color/text_secondary"
        android:textSize="10sp" />

</LinearLayout>