<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F9F9F9"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@android:drawable/ic_dialog_info"
            app:tint="#D32F2F" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Main Warehouse"
            android:textColor="#212121"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Operating"
            android:textColor="#4CAF50"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="INVENTORY"
                android:textColor="#D32F2F"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nav_stock_levels"
                style="@style/SidebarItem"
                android:drawableStart="@android:drawable/ic_menu_sort_by_size"
                android:drawablePadding="16dp"
                android:text="Stock Levels" />

            <TextView
                android:id="@+id/nav_locations"
                style="@style/SidebarItem"
                android:drawableStart="@android:drawable/ic_dialog_map"
                android:drawablePadding="16dp"
                android:text="Bin Locations" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="12dp"
                android:text="OPERATIONS"
                android:textColor="#D32F2F"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nav_pending_requests"
                style="@style/SidebarItem"
                android:drawableStart="@android:drawable/ic_menu_recent_history"
                android:drawablePadding="16dp"
                android:text="Pending Requests" />

            <TextView
                android:id="@+id/nav_reorder_list"
                style="@style/SidebarItem"
                android:drawableStart="@android:drawable/stat_sys_warning"
                android:drawablePadding="16dp"
                android:text="Reorder Alerts" />

        </LinearLayout>
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:text="KineticGear v1.0.4 - Stores"
        android:textColor="#BDBDBD"
        android:textSize="10sp" />

</LinearLayout>