<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 🔥 PROFESSIONAL RED BUTTONS -->
    <style name="BtnPro" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/red_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">68dp</item>
        <item name="android:elevation">4dp</item>
    </style>

    <!-- 🟤 PROFESSIONAL BEIGE BUTTONS -->
    <style name="BtnBeige" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/beige_dark</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <!-- 📱 SIDEBAR ITEMS (UPGRADED) -->
    <style name="SidebarItem" parent="Widget.MaterialComponents.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">20dp</item>
        <item name="android:textColor">@color/red_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:elevation">2dp</item>
    </style>

    <!-- 📱 SELECTED SIDEBAR (HOVER EFFECT) -->
    <style name="SidebarItem.Selected" parent="SidebarItem">
        <item name="android:background">@color/beige_dark</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:elevation">6dp</item>
    </style>

    <!-- 🎯 DASHBOARD CARDS -->
    <style name="CardPro" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">8dp</item>
        <item name="android:layout_margin">12dp</item>
    </style>

    <!-- 📝 PROFESSIONAL TEXT -->
    <style name="TextTitle">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/red_primary</item>
    </style>

    <style name="TextSubtitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/red_dark</item>
        <item name="android:alpha">0.8</item>
    </style>

    <!-- ... your other styles (BtnPro, SidebarItem, etc) ... -->


    </resources>